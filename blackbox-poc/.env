# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# --- Security ---
SECRET_KEY=change-me-in-production

# --- Owner ---
BLACKBOX_OWNER_ID=oscar_broome
BLACKBOX_OWNER_NAME=Oscar Broome
BLACKBOX_OWNER_PASSWORD=change-me-to-a-strong-password

# --- Era Evolution ---
ERA_EVOLUTION_THRESHOLD=10

# --- Rate limits ---
RATE_LIMIT_PREMIUM=1000
RATE_LIMIT_FREE=100

# --- GPU (optional, informational only in this POC) ---
CUDA_VISIBLE_DEVICES=0
ENABLE_GPU_ACCELERATION=False

# NOTE: MEMORY_DB_PATH and USERS_FILE are intentionally NOT set here.
# Both memory.py and auth.py now resolve absolute paths from __file__
# by default, so the server works regardless of the working directory.
